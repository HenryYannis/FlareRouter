{
  "name": "flarerouter",
  "version": "1.0.0",
  "private": true,
  "description": "Personal AI gateway on a single Cloudflare Worker: OpenAI + Anthropic APIs, failover, logs, admin page",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.156.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HenryYannis/flarerouter.git"
  }
}
